@model ContactFormModel

<!-- Contact Start -->
<div class="container-xxl py-6 pt-5" id="contact">
    <div class="col-lg-6 mb-5">
        <h1 class="display-5 mb-0">Contact Us</h1>
    </div>

    <form method="post" class="contact-form">
        <!-- Display ModelState validation summary if invalid -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                Please fix the errors in the form.
            </div>
        }

        <div class="mb-3">
            <label for="name" class="form-label">@Model.NameLabel</label>
            <input type="text" id="name" name="NameLabel" class="form-control" placeholder="@Model.NamePlaceholder" value="@Model.NameLabel" required>
            @Html.ValidationMessageFor(model => model.NameLabel, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">@Model.EmailLabel</label>
            <input type="email" id="email" name="EmailLabel" class="form-control" placeholder="@Model.EmailPlaceholder" value="@Model.EmailLabel" required>
            @Html.ValidationMessageFor(model => model.EmailLabel, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="title" class="form-label">@Model.TitleLabel</label>
            <input type="text" id="title" name="TitleLabel" class="form-control" placeholder="@Model.TitlePlaceholder" value="@Model.TitleLabel" required>
            @Html.ValidationMessageFor(model => model.TitleLabel, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="message" class="form-label">@Model.MessageLabel</label>
            <textarea id="message" name="MessageLabel" class="form-control" placeholder="@Model.MessagePlaceholder" rows="4" required>@Model.MessageLabel</textarea>
            @Html.ValidationMessageFor(model => model.MessageLabel, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Відправити</button>
    </form>
</div>
<!-- Contact End -->
<!-- Summary of all validation errors -->
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
