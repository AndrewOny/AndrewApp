@model ContactFormModel

<form method="post" class="contact-form">
    <div class="mb-3">
        <label for="name" class="form-label">@Model.NameLabel</label>
        <input type="text" id="name" name="name" class="form-control" placeholder="@Model.NamePlaceholder" required>
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">@Model.EmailLabel</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="@Model.EmailPlaceholder" required>
    </div>

    <div class="mb-3">
        <label for="title" class="form-label">@Model.TitleLabel</label>
        <input type="text" id="title" name="title" class="form-control" placeholder="@Model.TitlePlaceholder" required>
    </div>

    <div class="mb-3">
        <label for="message" class="form-label">@Model.MessageLabel</label>
        <textarea id="message" name="message" class="form-control" placeholder="@Model.MessagePlaceholder" rows="4" required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>

