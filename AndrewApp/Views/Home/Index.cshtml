        </div>
    </nav>
    <!-- Navbar End -->
    <!-- Header Start -->
    <div class="d-flex justify-content-between align-items-center mt-5 min-vh-70 bg-light p-5" id="home">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 py-6 pb-0 pt-lg-0">
                    <!-- Apply ml-5 (margin-left) to the text container -->
                    <div class="ml-5">
                        <h3 class="text-primary mb-3">I'm</h3>
                        <h1 class="display-3 mb-3">Andrew Onyshchuk</h1>
                        <h2 class="typed-text-output d-inline"></h2>
                        <div class="typed-text d-none">Web Developer, Front End Developer, Apps Developer</div>

                        <div class="d-flex justify-content-start align-items-center mt-5">
                            <!-- Кнопка відкриття модального вікна with margin-right -->
                            <button type="button" class="btn btn-lg btn-primary px-5 py-3 fw-bold shadow-lg me-3" data-bs-toggle="modal" data-bs-target="#imageModal">
                                Review CV
                            </button>

                            <!-- Кнопка для завантаження файлу -->
                            <a href="img/MyCv.pdf" download class="btn btn-lg btn-primary px-5 py-3 fw-bold shadow-lg">
                                Download CV
                            </a>
                        </div>

                        <!-- The Modal -->
                        <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <!-- Added modal-lg class here -->
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="imageModalLabel">My Portfolio</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <iframe src="img/MyCv.pdf"
                                                frameBorder="0"
                                                scrolling="auto"
                                                height="800px"
                                                width="100%">
                                        </iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img class="img-fluid" src="img/logo.svg" alt="">
                </div>
            </div>
        </div>
    </div>



    <!-- Header End -->
    <!-- Video Modal Start -->
    <div class="modal modal-video fade" id="videoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h3 class="modal-title" id="exampleModalLabel">Youtube Video</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
