    <!-- Header End -->

    <!-- About Start -->
        
    <div class="container-xxl py-6" id="about">
        <div class="col-lg-6">
            <h1 class="display-5 mb-5">About Me</h1>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="box-shadow-full">
                    <div class="row">

                        <div class="row">
                            <div class="col-md-3">
                                <div class="about-img">
                                    <img src="img/profile.jpg" class="img-fluid rounded b-shadow-a" alt="">
                                </div>
                            </div>
                            <div class="col">
                                <div class="about-info">
