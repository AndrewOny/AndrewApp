@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Andrew - Personal Developer</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
</head>

<body data-bs-spy="scroll" data-bs-target=".navbar" data-bs-offset="51">

    <!-- Navbar Start -->
    <nav class="navbar navbar-expand-lg bg-white navbar-light fixed-top shadow py-lg-0 px-4 px-lg-5 wow fadeIn" data-wow-delay="0.1s">
        <a href="index.html" class="navbar-brand d-block d-lg-none">
            <h1 class="text-primary fw-bold m-0">Main</h1>
        </a>
        <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-between py-4 py-lg-0" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="#home" class="nav-item nav-link active">Home</a>
                <a href="#about" class="nav-item nav-link">About</a>
                <a href="#skill" class="nav-item nav-link">Skills</a>
            </div>
            <div class="navbar-nav me-auto py-0">
                <a href="#project" class="nav-item nav-link">Projects</a>
                <a href="#testimonial" class="nav-item nav-link">Testimonial</a>
                <a href="#contact" class="nav-item nav-link">Contact</a>
            </div>
        </div>
    </nav>
    <!-- Navbar End -->
    <!-- Header Start -->
    <div class="container-fluid bg-light my-6 mt-0" id="home">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 py-6 pb-0 pt-lg-0">
                    <h3 class="text-primary mb-3">I'm</h3>
                    <h1 class="display-3 mb-3">Andrew Onyshchuk</h1>
                    <h2 class="typed-text-output d-inline"></h2>
                    <div class="typed-text d-none">Web Developer, Front End Developer, Apps Developer</div>

                    <div class="d-flex flex-column align-items-start justify-content-start min-vh-70 bg-light p-5">
                        <!-- Кнопка відкриття модального вікна -->
                        <button type="button" class="btn btn-lg btn-primary px-5 py-3 fw-bold shadow-lg" data-bs-toggle="modal" data-bs-target="#imageModal">
                            Open CV
                        </button>
                    </div>


                    <!-- The Modal -->
                    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="imageModalLabel">My CV</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <img class="img-fluid" src="img/CV.jpg" alt="CV">
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
                <div class="col-lg-6">
                    <img class="img-fluid" src="img/profile.jpg" alt="">
                </div>
            </div>
        </div>
    </div>
    <!-- Header End -->
    <!-- Video Modal Start -->
    <div class="modal modal-video fade" id="videoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h3 class="modal-title" id="exampleModalLabel">Youtube Video</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- 16:9 aspect ratio -->
                    <div class="ratio ratio-16x9">
                        <iframe class="embed-responsive-item" src="" id="video" allowfullscreen allowscriptaccess="always"
                                allow="autoplay"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Video Modal End -->
    <!-- About Start -->
    <div class="container-xxl py-6" id="about">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="d-flex align-items-center mb-5">
                        <div class="years flex-shrink-0 text-center me-4">
                            <h1 class="display-1 mb-0">10+</h1>
                            <h5 class="mb-0">Years</h5>
                        </div>
                        <h3 class="lh-base mb-0">of experience in full-stack development</h3>
                    </div>
                    <p class="mb-4">I am a skilled C# full-stack developer with expertise in ASP.NET Core, MVC, and database design. Passionate about building efficient and scalable applications, I specialize in creating high-quality software solutions tailored to client needs.</p>
                    <p class="mb-3"><i class="far fa-check-circle text-primary me-3"></i>Strong expertise in C#, .NET, and SQLite</p>
                    <p class="mb-3"><i class="far fa-check-circle text-primary me-3"></i>Experience in database architecture and API development</p>
                    <p class="mb-3"><i class="far fa-check-circle text-primary me-3"></i>Committed to clean and maintainable code</p>
                    <a class="btn btn-primary py-3 px-5 mt-3" href="#portfolio">View My Work</a>
                </div>
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <img class="img-fluid rounded" src="img/profile-1.jpg" alt="Profile Image">
                        </div>
                        <div class="col-sm-6">
                            <img class="img-fluid rounded" src="img/profile-2.jpg" alt="Coding Image">
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <h5 class="border-end pe-3 me-3 mb-0">Successful Projects</h5>
                        <h2 class="text-primary fw-bold mb-0" data-toggle="counter-up">50+</h2>
                    </div>
                    <p class="mb-4">I have developed and deployed various projects, including enterprise applications, CMS solutions, and database-driven web platforms.</p>
                    <div class="d-flex align-items-center mb-3">
                        <h5 class="border-end pe-3 me-3 mb-0">Happy Clients</h5>
                        <h2 class="text-primary fw-bold mb-0" data-toggle="counter-up">30+</h2>
                    </div>
                    <p class="mb-0">I take pride in delivering top-quality software solutions that exceed client expectations.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- About End -->
    <!-- CMS Sections-->
    @model List<CmsSectionModel>
    <div class="container-xxl py-6 pb-5" id="skill">
        <div class="container">
            <h1 class="display-5 mb-5">Skills & Experience</h1>
            <p class="mb-4">
                As a Full Stack Developer with expertise in C#, I have a proven track record in designing and developing scalable web applications.
                From building robust back-end APIs to creating responsive and dynamic front-end user interfaces, I manage the entire development
                process to deliver seamless, high-performing solutions.
            </p>
            <!-- Navigation pills for Skills and Projects -->
            <ul class="nav nav-pills rounded border border-2 border-primary mb-5">
                <li class="nav-item w-50">
                    <button class="nav-link w-100 py-3 fs-5 active" id="skills-tab" data-bs-toggle="pill" data-bs-target="#skills" aria-controls="skills" aria-selected="true">Skills</button>
                </li>
                <li class="nav-item w-50">
                    <button class="nav-link w-100 py-3 fs-5" id="experience-tab" data-bs-toggle="pill" data-bs-target="#experience" aria-controls="experience" aria-selected="false">Experience</button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Skills Section -->
                <div class="tab-pane fade show active" id="skills" role="tabpanel" aria-labelledby="skills-tab">
                    <p class="mb-4">
                        I am proficient in C#, JavaScript, HTML, CSS, and various other technologies. With expertise in both back-end and front-end development,
                        I design and implement robust systems that are scalable, maintainable, and responsive. My key strengths include problem-solving, coding best practices,
                        and keeping up with emerging technologies.
                    </p>
                    <h3 class="mb-4">My Skills</h3>
                    <div class="row align-items-center">
                        @foreach (var cmsSection in Model.Where(cs => !cs.Title.Contains("-") && !cs.Title.Contains("Project")))
                        {
                            <div class="col-md-4 mb-4">
                                <div class="section p-4 border rounded">
                                    <h5>@cmsSection.Title</h5>
                                    <hr class="text-primary my-2">
                                    <p>@cmsSection.Description</p>
                                    @if (!string.IsNullOrEmpty(cmsSection.Image?.Path))
                                    {
                                        <img src="@cmsSection.Image.Path" alt="@cmsSection.Title" class="img-fluid mt-3">
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Projects Section -->
                <div class="tab-pane fade" id="experience" role="tabpanel" aria-labelledby="experience-tab">
                    <p class="mb-4">
                        I have worked on various full-stack development projects, including building scalable web applications, designing APIs,
                        and integrating front-end technologies. These projects range from e-commerce platforms to custom business solutions,
                        all focused on enhancing user experience and ensuring high performance.
                    </p>
                    <h3 class="mb-4">My Experience</h3>
                    <div class="row mt-4">
                        @foreach (var cmsSection in Model.Where(cs => cs.Title.Contains("-")))
                        {
                            <div class="col-md-4 mb-4">
                                <div class="section p-4 border rounded">
                                    <h5>@cmsSection.Title</h5>
                                    <hr class="text-primary my-2">
                                    <p>@cmsSection.Description</p>
                                    @if (!string.IsNullOrEmpty(cmsSection.Image?.Path))
                                    {
                                        <img src="@cmsSection.Image.Path" alt="@cmsSection.Title" class="img-fluid mt-3">
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Projects Start -->
    <div class="container-xxl py-6 pt-5" id="project">
        <div class="container">
            <div class="row g-5 mb-5 align-items-center wow fadeInUp" data-wow-delay="0.1s">
                <div class="col-lg-6">
                    <h1 class="display-5 mb-0">My Projects</h1>
                </div>
            </div>

            <!-- Single row for all portfolio items -->
            <div class="row g-4 portfolio-container wow fadeInUp" data-wow-delay="0.1s">
                @foreach (var cmsSection in Model.Where(cs => cs.Title.Contains("C#")))
                {
                    <div class="col-lg-4 col-md-6 portfolio-item first">
                        <div class="portfolio-img rounded overflow-hidden">
                            <img class="img-fluid"
                                 src="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/Csharp.png")"
                                 alt="@cmsSection.Title"
                                 style="height: 250px; object-fit: cover; width: 100%;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 data-bs-img-src="@(cmsSection.Image?.Path ?? "img/Csharp.png")">
                        </div>

                        <!-- ✅ Title & Description Section -->
                        <div class="p-4 border rounded bg-white shadow-sm mt-3">
                            <h5 class="text-dark">@cmsSection.Title</h5>
                            <hr class="text-primary my-2">
                            <p class="text-secondary">@cmsSection.Description</p>
                        </div>
                    </div>
                }

                @foreach (var cmsSection in Model
                .Where(cs => cs.Title.Contains("Kotlin", StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="col-lg-4 col-md-6 portfolio-item first">
                        <div class="portfolio-img rounded overflow-hidden">
                            <img class="img-fluid"
                                 src="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/Kotlin.png")"
                                 alt="@cmsSection.Title"
                                 style="height: 250px; object-fit: cover; width: 100%;">
                            <div class="portfolio-btn">
                                <a class="btn btn-lg-square btn-outline-secondary border-2 mx-1"
                                   href="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/Kotlin.png")"
                                   data-lightbox="portfolio">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </div>
                        </div>

                        <!-- ✅ Title & Description Section -->
                        <div class="p-4 border rounded bg-white shadow-sm mt-3">
                            <h5 class="text-dark">@cmsSection.Title</h5>
                            <hr class="text-primary my-2">
                            <p class="text-secondary">@cmsSection.Description</p>
                        </div>
                    </div>
                }


                @foreach (var cmsSection in Model.Where(cs => cs.Title.Contains("React")))
                {
                    <div class="col-lg-4 col-md-6 portfolio-item first">
                        <div class="portfolio-img rounded overflow-hidden">
                            <img class="img-fluid"
                                 src="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/React.png")"
                                 alt="@cmsSection.Title"
                                 style="height: 250px; object-fit: cover; width: 100%;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 data-bs-img-src="@(cmsSection.Image?.Path ?? "img/React.png")">
                        </div>

                        <!-- ✅ Title & Description Section -->
                        <div class="p-4 border rounded bg-white shadow-sm mt-3">
                            <h5 class="text-dark">@cmsSection.Title</h5>
                            <hr class="text-primary my-2">
                            <p class="text-secondary">@cmsSection.Description</p>
                        </div>
                    </div>
                }

                @foreach (var cmsSection in Model.Where(cs => cs.Title.Contains("C#")))
                {
                    <div class="col-lg-4 col-md-6 portfolio-item first">
                        <div class="portfolio-img rounded overflow-hidden">
                            <img class="img-fluid"
                                 src="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/Csharp.png")"
                                 alt="@cmsSection.Title"
                                 style="height: 250px; object-fit: cover; width: 100%;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 data-bs-img-src="@(cmsSection.Image?.Path ?? "img/Csharp.png")">
                        </div>

                        <!-- ✅ Title & Description Section -->
                        <div class="p-4 border rounded bg-white shadow-sm mt-3">
                            <h5 class="text-dark">@cmsSection.Title</h5>
                            <hr class="text-primary my-2">
                            <p class="text-secondary">@cmsSection.Description</p>
                        </div>
                    </div>
                }

                @foreach (var cmsSection in Model
                .Where(cs => cs.Title.Contains("Kotlin", StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="col-lg-4 col-md-6 portfolio-item first">
                        <div class="portfolio-img rounded overflow-hidden">
                            <img class="img-fluid"
                                 src="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/Kotlin.png")"
                                 alt="@cmsSection.Title"
                                 style="height: 250px; object-fit: cover; width: 100%;">
                            <div class="portfolio-btn">
                                <a class="btn btn-lg-square btn-outline-secondary border-2 mx-1"
                                   href="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/Kotlin.png")"
                                   data-lightbox="portfolio">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </div>
                        </div>

                        <!-- ✅ Title & Description Section -->
                        <div class="p-4 border rounded bg-white shadow-sm mt-3">
                            <h5 class="text-dark">@cmsSection.Title</h5>
                            <hr class="text-primary my-2">
                            <p class="text-secondary">@cmsSection.Description</p>
                        </div>
                    </div>
                }


                @foreach (var cmsSection in Model.Where(cs => cs.Title.Contains("React")))
                {
                    <div class="col-lg-4 col-md-6 portfolio-item first">
                        <div class="portfolio-img rounded overflow-hidden">
                            <img class="img-fluid"
                                 src="@(cmsSection.Image != null ? cmsSection.Image.Path : "img/React.png")"
                                 alt="@cmsSection.Title"
                                 style="height: 250px; object-fit: cover; width: 100%;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 data-bs-img-src="@(cmsSection.Image?.Path ?? "img/React.png")">
                        </div>

                        <!-- ✅ Title & Description Section -->
                        <div class="p-4 border rounded bg-white shadow-sm mt-3">
                            <h5 class="text-dark">@cmsSection.Title</h5>
                            <hr class="text-primary my-2">
                            <p class="text-secondary">@cmsSection.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Projects End -->
