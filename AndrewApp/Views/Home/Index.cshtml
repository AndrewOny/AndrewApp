                    <div class="ratio ratio-16x9">
                        <iframe class="embed-responsive-item" src="" id="video" allowfullscreen allowscriptaccess="always"
                                allow="autoplay"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Video Modal End -->
    <!-- About Start -->
    <div class="container-xxl py-6" id="about">
        <div class="row">
            <div class="col-sm-12">
                <div class="box-shadow-full">
                    <div class="row">
                        <!-- Left Column (Image, Info, Table) -->
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-sm-6 col-md-5">
                                    <div class="about-img">
                                        <img src="img/profile.jpg" class="img-fluid rounded b-shadow-a" alt="">
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-7">
                                    <div class="about-info">
                                        <p><span class="title-s"><strong>Name: </strong></span> <span>Description 1</span></p>
                                        <p><span class="title-s"><strong>Profile: </strong></span> <span>Description 2</span></p>
                                        <p><span class="title-s"><strong>Email: </strong></span> <span>Description 3</span></p>
                                        <p><span class="title-s"><strong>GitHub: </strong></span> <span>Description 3</span></p>
                                        <p><span class="title-s"><strong>Instagram: </strong></span> <span>Description 3</span></p>
                                        <p><span class="title-s"><strong>Telegram: </strong></span> <span>Description 3</span></p>
                                    </div>
                                </div>

                                <table style="margin-top: 20px;">
                                    <tr>
                                        <td><h5 class="title-left">Good Habits:</h5></td>
                                        <td><h5 class="title-left">Communication:</h5></td>
                                        <td><h5 class="title-left">Decision Making:</h5></td>
                                    </tr>
                                    <tr>
                                        <td>• Flexibility of mind and actions;</td>
                                        <td>• I am able to communicate and negotiate;</td>
                                        <td>• I make a decision;</td>
                                    </tr>
                                    <tr>
                                        <td>• Developing emotional intelligence;</td>
                                        <td>• I can manage people;</td>
                                        <td>• Creativity & Problem Solving;</td>
                                    </tr>
                                    <tr>
                                        <td>• Working on critical thinking;</td>
                                        <td>• I like consistency and responsibility;</td>
                                        <td>• Interaction with others;</td>
                                    </tr>
                                </table>

                            </div>
                        </div>

                        <!-- Right Column (Profile and Education) -->
                        <div class="col-md-6">
                            <div class="about-me pt-4 pt-md-0">
                                <div class="title-box-2">
                                    <h5 class="title-left">
                                        <strong>Profile</strong>
                                    </h5>
                                </div>
                                <p class="lead">As a passionate Trainee Android Developer with hands-on experience</p>
                                <p class="lead">in creating intuitive and high-performing mobile applications, I thrive</p>
                                <p class="lead">in transforming ideas into reality. With strong skills in Java, Kotlin,</p>
                                <p class="lead">and UI/UX design, I bring energy, creativity, and a problem-solving</p>
                                <p class="lead">mindset to every project. Let's build the future of mobile together!</p>
                            </div>

                            <!-- Education Section under Profile -->
                            <div class="about-me pt-4 pt-md-0">
                                <div class="title-box-2">
                                    <h5 class="title-left">
                                        <strong>Education</strong>
                                    </h5>
                                </div>
                                <p class="lead">Bachelor of Science in Computer Science from XYZ University</p>
                                <p class="lead">Graduated with a strong focus on mobile app development and programming languages.</p>
                                <p class="lead">Attended various workshops on Android development and UI/UX design principles.</p>
                                <p class="lead">Currently pursuing advanced courses in mobile app performance optimization.</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- About End -->
    <!-- CMS Sections-->
    @model List<CmsSectionModel>
    <div class="container-xxl py-6 pb-5" id="skill">
        <div class="container">
            <h1 class="display-5 mb-5">Skills & Experience</h1>
            <p class="mb-4">
                As a Full Stack Developer with expertise in C#, I have a proven track record in designing and developing scalable web applications.
                From building robust back-end APIs to creating responsive and dynamic front-end user interfaces, I manage the entire development
                process to deliver seamless, high-performing solutions.
            </p>
            <!-- Navigation pills for Skills and Projects -->
            <ul class="nav nav-pills rounded border border-2 border-primary mb-5">
                <li class="nav-item w-50">
                    <button class="nav-link w-100 py-3 fs-5 active" id="skills-tab" data-bs-toggle="pill" data-bs-target="#skills" aria-controls="skills" aria-selected="true">Skills</button>
                </li>
                <li class="nav-item w-50">
                    <button class="nav-link w-100 py-3 fs-5" id="experience-tab" data-bs-toggle="pill" data-bs-target="#experience" aria-controls="experience" aria-selected="false">Experience</button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Skills Section -->
                <div class="tab-pane fade show active" id="skills" role="tabpanel" aria-labelledby="skills-tab">
                    <p class="mb-4">
                        I am proficient in C#, JavaScript, HTML, CSS, and various other technologies. With expertise in both back-end and front-end development,
                        I design and implement robust systems that are scalable, maintainable, and responsive. My key strengths include problem-solving, coding best practices,
                        and keeping up with emerging technologies.
                    </p>
                    <h3 class="mb-4">My Skills</h3>
                    <div class="row align-items-center">
                        @foreach (var cmsSection in Model.Where(cs => !cs.Title.Contains("-") && !cs.Title.Contains("Project")))
                        {
                            <div class="col-md-4 mb-4">
                                <div class="section p-4 border rounded">
                                    <h5>@cmsSection.Title</h5>
                                    <hr class="text-primary my-2">
                                    <p>@cmsSection.Description</p>
                                    @if (!string.IsNullOrEmpty(cmsSection.Image?.Path))
                                    {
                                        <img src="@cmsSection.Image.Path" alt="@cmsSection.Title" class="img-fluid mt-3">
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Projects Section -->
                <div class="tab-pane fade" id="experience" role="tabpanel" aria-labelledby="experience-tab">
                    <p class="mb-4">
                        I have worked on various full-stack development projects, including building scalable web applications, designing APIs,
                        and integrating front-end technologies. These projects range from e-commerce platforms to custom business solutions,
                        all focused on enhancing user experience and ensuring high performance.
                    </p>
                    <h3 class="mb-4">My Experience</h3>
                    <div class="row mt-4">
                        @foreach (var cmsSection in Model.Where(cs => cs.Title.Contains("-")))
                        {
                            <div class="col-md-4 mb-4">
                                <div class="section p-4 border rounded">
                                    <h5>@cmsSection.Title</h5>
                                    <hr class="text-primary my-2">
                                    <p>@cmsSection.Description</p>
                                    @if (!string.IsNullOrEmpty(cmsSection.Image?.Path))
                                    {
                                        <img src="@cmsSection.Image.Path" alt="@cmsSection.Title" class="img-fluid mt-3">
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Projects Start -->
