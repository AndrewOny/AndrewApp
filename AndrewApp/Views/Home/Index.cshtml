    <!-- Contact Start -->
    <div class="container-xxl py-6 pt-5" id="contact">
        <div class="col-lg-6 mb-5">
            <h1 class="display-5 mb-0">Contact Us</h1>
        </div>
        <form method="post" class="contact-form">
            <div class="mb-3">
                <label for="name" class="form-label">Ваше ім'я</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Введіть ім'я" required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="Введіть email" required>
            </div>

            <div class="mb-3">
                <label for="title" class="form-label">Заголовок</label>
                <input type="text" id="title" name="title" class="form-control" placeholder="Введіть заголовок" required>
            </div>

            <div class="mb-3">
                <label for="message" class="form-label">Повідомлення</label>
                <textarea id="message" name="message" class="form-control" placeholder="Введіть ваше повідомлення" rows="4" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Відправити</button>
        </form>
    </div>
    <!-- Contact End -->
